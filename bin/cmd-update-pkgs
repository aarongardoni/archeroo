#!/bin/bash

# checkupdates handles its own temp DB by default, but we'll filter for explicit
# Using -Fcf counts the matches directly for the 'if' check
raw_updates=$(checkupdates 2>/dev/null)
explicit_updates=$(echo "$raw_updates" | grep -Ff <(pacman -Qeq))

if [ -z "$explicit_updates" ]; then
    echo "Explicit packages are already up to date!"
    pkill -RTMIN+7 waybar
    command -v cmd-show-done >/dev/null && cmd-show-done
    exit 0
fi

echo "Explicit packages to update:"
echo "$explicit_updates"
echo

# Use gum to confirm
if gum confirm "Update all (Repo + AUR)?"; then
    # yay -Syu is the "all-in-one" for Arch; no need for a separate pacman call
    yay -Syu --noconfirm

    # Signal waybar to refresh
    pkill -RTMIN+7 waybar

    # Check if your custom command exists before running
    command -v cmd-show-done >/dev/null && cmd-show-done
else
    echo "Update cancelled."
    exit 0
fi

