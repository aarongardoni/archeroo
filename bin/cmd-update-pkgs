#!/bin/bash
# Interactive package updater, launched in a floating terminal from waybar.
# Shows the same explicit repo+AUR updates as the waybar badge, then performs
# a full system upgrade (the only safe upgrade path on Arch).

set -uo pipefail

refresh_waybar() { pkill -RTMIN+7 waybar 2>/dev/null; }

finish() {
  refresh_waybar
  command -v cmd-show-done >/dev/null && cmd-show-done
}

echo "Checking for updates..."
updates=$(cmd-list-updates)

if [[ -z "$updates" ]]; then
  echo "Explicit packages are already up to date!"
  finish
  exit 0
fi

echo "Explicit packages with pending updates:"
echo "$updates"
echo

# Note: yay -Syu also pulls dependency/non-explicit updates — partial upgrades
# are unsupported on Arch, so the full upgrade is intentional.
if gum confirm "Run a full system upgrade (yay -Syu)?"; then
  yay -Syu --noconfirm
  finish
else
  echo "Update cancelled."
fi
